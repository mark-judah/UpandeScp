  "html": "<div class=\"scpn\">\n  <div class=\"scpn-title\">Scouting &amp; Crop Protection</div>\n  <div class=\"scpn-grid\">\n\n    <a class=\"scpn-tile\" data-roles=\"\" href=\"/scp_app#/rose/dashboard\">\n      <span class=\"scpn-ic\" style=\"background:rgba(59,130,246,.13);color:#3b82f6\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"9\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"5\"/><rect x=\"14\" y=\"12\" width=\"7\" height=\"9\"/><rect x=\"3\" y=\"16\" width=\"7\" height=\"5\"/></svg></span>\n      <span class=\"scpn-tx\"><span class=\"scpn-lb\">Dashboards</span><span class=\"scpn-sub\">Overview &amp; KPIs</span></span>\n    </a>\n\n    <a class=\"scpn-tile\" data-roles=\"\" href=\"/scp_app#/rose/scouting-map\">\n      <span class=\"scpn-ic\" style=\"background:rgba(34,197,94,.13);color:#16a34a\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"/><circle cx=\"12\" cy=\"10\" r=\"3\"/></svg></span>\n      <span class=\"scpn-tx\"><span class=\"scpn-lb\">Scouting</span><span class=\"scpn-sub\">Today's scout movement</span></span>\n    </a>\n\n    <a class=\"scpn-tile\" data-roles=\"\" href=\"/scp_app#/rose/spraying\">\n      <span class=\"scpn-ic\" style=\"background:rgba(6,182,212,.13);color:#0891b2\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 2s6 7 6 12a6 6 0 0 1-12 0c0-5 6-12 6-12z\"/></svg></span>\n      <span class=\"scpn-tx\"><span class=\"scpn-lb\">Spraying</span><span class=\"scpn-sub\">Sprayer GPS tracks</span></span>\n    </a>\n\n    <a class=\"scpn-tile\" data-roles=\"\" href=\"/scp_app#/rose/application-plan\">\n      <span class=\"scpn-ic\" style=\"background:rgba(139,92,246,.13);color:#7c53e0\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0